{
  "name": "docvault",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DocVault — Freemius x Claude Skills reference app. PDF → OCR text, gated behind a Freemius subscription.",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "npm run prisma:generate && npm run build:web",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "prisma db push --skip-generate --accept-data-loss && tsx src/server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.web.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@freemius/checkout": "^1.4.1",
    "@freemius/sdk": "^0.3.0",
    "@hono/node-server": "^1.13.8",
    "@mistralai/mistralai": "^2.3.0",
    "@prisma/client": "^6.3.0",
    "hono": "^4.12.27",
    "prisma": "^6.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.1.5",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  }
}
