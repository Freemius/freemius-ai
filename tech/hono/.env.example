# DocVault environment variables — copy to .env and fill in. NEVER commit real secrets.
# All values below are server-side only and must NOT be VITE_-prefixed.

# --- Freemius (Developer Dashboard → Settings → Keys / Product → Settings) ---
FREEMIUS_PRODUCT_ID=your_product_id
FREEMIUS_PUBLIC_KEY=pk_your_public_key
FREEMIUS_SECRET_KEY=sk_your_secret_key
FREEMIUS_API_KEY=your_api_token

# --- Plan-tier feature mapping (optional; plan IDs from the Freemius Dashboard) ---
# Premium (the default subscription plan) = unlimited PDF OCR only.
# PRO_PLAN_ID      = the Pro subscription plan → unlimited PDF + image OCR.
# LIFETIME_PLAN_ID = the one-off lifetime plan → unlimited everything, forever.
# Leave empty to disable the tier distinction (every entitlement behaves like Premium).
PRO_PLAN_ID=your-pro-plan-id
LIFETIME_PLAN_ID=your-lifetime-plan-id

# --- Credits / top-up demo (optional) ---
# The one-off (lifetime-priced) "credits" plan in the Freemius Dashboard. One
# purchase of it grants CREDITS_PER_PURCHASE OCR page-credits (top-ups stack;
# PDF + image allowed, metered per page).
# Leave CREDITS_PLAN_ID empty to disable credit grants (subscriptions unaffected).
CREDITS_PLAN_ID=your-credits-plan-id
CREDITS_PER_PURCHASE=100

# --- Mistral OCR (https://console.mistral.ai/) ---
MISTRAL_API_KEY=your_mistral_api_key

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/docvault?schema=public

# --- App ---
# Public base URL the user sees (used for checkout redirect signature verification).
# Local dev: the Vite dev server. Production: your deployed domain.
PUBLIC_APP_URL=http://localhost:5173
PORT=8787
NODE_ENV=development

# --- Deploy flags (optional) ---
# On a deployed host you typically set NODE_ENV=production but still want the
# Freemius SANDBOX for validation. These two flags decouple that from NODE_ENV:
#   SERVE_STATIC=true     → serve the built Vite frontend from the Hono process
#                           (defaults to true when NODE_ENV=production)
#   FREEMIUS_SANDBOX=true → target the Freemius sandbox/test mode
#                           (defaults to true unless NODE_ENV=production)
# For a Railway validation instance: NODE_ENV=production, SERVE_STATIC=true,
# FREEMIUS_SANDBOX=true.
# SERVE_STATIC=true
# FREEMIUS_SANDBOX=true

# --- Public POC gate (optional) ---
# Optional HTTP Basic Auth gate for public POC/demo deployments.
# Set BOTH to enable; leave empty for local dev (no gate).
# NOTE: /api/health and /api/webhooks/* are intentionally exempt so monitoring
# and Freemius server-to-server webhooks keep working.
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
